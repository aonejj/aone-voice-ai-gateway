rtc_audio_utils_root = get_path_info(".", "abspath")
rtc_audio_utils_config = [ rtc_audio_utils_root + ":RTCAudioUtilsConfig" ]
rtc_audio_utils_link_configs = [ rtc_audio_utils_root + ":RTCAudioUtilsLinkConfig" ]

set_defaults("rtc_audio_utils_source_set") {
    configs = rtc_audio_utils_config
}

set_defaults("rtc_audio_utils_shared_library") {
    configs = rtc_audio_utils_link_configs    
}

template("rtc_audio_utils_source_set") {
  source_set(target_name) {
    forward_variables_from(invoker,
                           "*",
                           [
                            "configs", 
                           ])
    if (defined(invoker.configs)) {
      configs += invoker.configs
    }
  }    
}

template("rtc_audio_utils_shared_library") {
  shared_library(target_name) {
    forward_variables_from(invoker,
                           "*",
                           [
                             "configs",
                           ])
    if (defined(invoker.configs)) {
      configs += invoker.configs
    }
  }    
}