rtc_signaling_session_root = get_path_info(".", "abspath")
rtc_signaling_session_config = [ rtc_signaling_session_root + ":RTCSignalingSessionConfig" ]
rtc_signaling_session_link_configs = [ rtc_signaling_session_root + ":RTCSignalingSessionLinkConfig" ]


set_defaults("rtc_signaling_session_source_set") {
    configs = rtc_signaling_session_config
}

set_defaults("rtc_signaling_session_shared_library") {
    configs = rtc_signaling_session_link_configs    
}

template("rtc_signaling_session_source_set") {
  source_set(target_name) {
    forward_variables_from(invoker,
                           "*",
                           [
                            "configs", 
                           ])
    if (defined(invoker.configs)) {
      configs += invoker.configs
    }
  }    
}

template("rtc_signaling_session_shared_library") {
  shared_library(target_name) {
    forward_variables_from(invoker,
                           "*",
                           [
                             "configs",
                           ])
    if (defined(invoker.configs)) {
      configs += invoker.configs
    }
  }    
}