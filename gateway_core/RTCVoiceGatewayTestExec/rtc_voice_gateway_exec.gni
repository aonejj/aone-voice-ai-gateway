rtc_voice_gateway_exec_root = get_path_info(".", "abspath")
rtc_voice_gateway_exec_config = [ rtc_voice_gateway_exec_root + ":RTCVoiceGatewayExecConfig" ]
rtc_voice_gateway_exec_execConfig = [ rtc_voice_gateway_exec_root + ":RTCVoiceGatewayExec_ExecConfig" ]

set_defaults("rtc_server_node_exec_executable") {
    configs = rtc_voice_gateway_exec_config
    configs += rtc_voice_gateway_exec_execConfig
}

template("rtc_server_node_exec_executable") {
  executable(target_name) {
    forward_variables_from(invoker,
                            "*",
                           [
                            "configs", 
                           ])
    if (defined(invoker.configs)) {
      configs += invoker.configs
    }
  }
}