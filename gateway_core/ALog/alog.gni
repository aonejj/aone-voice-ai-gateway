log_root = get_path_info(".", "abspath")
log_configs = [ log_root + ":ALogConfig" ]
log_link_configs = [ log_root + ":ALogLinkConfig" ]


set_defaults("alog_source_set") {
    configs = log_configs
}

set_defaults("alog_shared_library") {
    configs = log_link_configs
}

template("alog_source_set") {
  source_set(target_name) {
    forward_variables_from(invoker,
                           "*",
                           [
                            "configs", 
                           ])
    if (defined(invoker.configs)) {
      configs += invoker.configs
    }
  }
}

template("alog_shared_library") {
  shared_library(target_name) {
    forward_variables_from(invoker,
                           "*",
                           [
                             "configs",
                           ])
    if (defined(invoker.configs)) {
      configs += invoker.configs
    }
  }
}

